# All settings are optional. Copy to .env and load it however your platform does
# (docker run --env-file .env, or the "Variables" tab on Zeabur/Railway/Fly...).
# 所有设置都是可选的。

# --- Server / 服务器 ---
# HOST=0.0.0.0            # default 127.0.0.1 (local only). The Dockerfile sets 0.0.0.0
# PORT=8080               # default 8765 locally; the Dockerfile sets 8080
# DATA_DIR=/data          # where app.db lives. MUST be a persistent volume in production

# --- Weekly specials email / 每周特价邮件 (leave SMTP_HOST empty to disable) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587           # 587 = STARTTLS, 465 = SSL
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# SMTP_FROM="Price Bot <you@gmail.com>"   # default: SMTP_USER
# APP_URL=https://your-domain.example      # link used inside the emails

# --- Coles store search / Coles 门店搜索 ---
# Public front-end key from coles.com.au. Read automatically from the Coles page; only set it
# if that page is blocked. Get it in the browser console on coles.com.au:
#   __RUNTIME_CONFIG__.BFF_API_SUBSCRIPTION_KEY
# COLES_BFF_KEY=
